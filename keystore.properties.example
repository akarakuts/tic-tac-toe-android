# Copy to keystore.properties in the repository root (gitignored).
# Keystore and RuStore artifacts: ../rustore/tic-tac-toe/ (see .cursor/rules/rustore-artifacts.mdc).
#
# Generate once (backup; losing the key blocks updates):
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#   → store under rustore/tic-tac-toe/
#
# RuStore / store consoles: upload the certificate or AAB as described in their developer docs, e.g.:
#   https://www.rustore.ru/help/developers/publishing-and-verifying-apps/app-publication/new-version-app/upload-aab
#
storeFile=../rustore/tic-tac-toe/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
